---
/** 技能雷达：五维 SVG，入场描边展开（构建期计算坐标，零运行时库；弱动效静态呈现） */
const AXES = [
  { label: "前端", value: 0.82 },
  { label: "边缘网络", value: 0.93 },
  { label: "AI 工程", value: 0.88 },
  { label: "量化研究", value: 0.74 },
  { label: "玄学修行", value: 0.66 },
];

const CX = 150;
const CY = 140;
const R = 96;
const pt = (r: number, i: number) => {
  const a = (-90 + (360 / AXES.length) * i) * (Math.PI / 180);
  return [CX + r * Math.cos(a), CY + r * Math.sin(a)] as const;
};
const ring = (r: number) => AXES.map((_, i) => pt(r, i).map((n) => n.toFixed(1)).join(",")).join(" ");
const rings = [R, R * 0.66, R * 0.33].map(ring);
const polygon = AXES.map((a, i) => pt(R * a.value, i).map((n) => n.toFixed(1)).join(",")).join(" ");
const dots = AXES.map((a, i) => ({ ...a, x: pt(R * a.value, i)[0].toFixed(1), y: pt(R * a.value, i)[1].toFixed(1) }));
const labels = AXES.map((a, i) => {
  const [x, y] = pt(R + 26, i);
  return { ...a, x: x.toFixed(1), y: y.toFixed(1), anchor: x < CX - 4 ? "end" : x > CX + 4 ? "start" : "middle" };
});
const PERIM = 5 * R; // 描边动画总长（近似，够用）
---

<section class="radar-wrap" aria-label="技能光谱">
  <h2 class="sec-title">技能光谱</h2>
  <svg class="radar" viewBox="0 0 300 280" role="img" aria-label={AXES.map((a) => `${a.label} ${Math.round(a.value * 100)}%`).join("，")}>
    {rings.map((points) => <polygon class="ring" points={points} />)}
    {AXES.map((_, i) => {
      const [x, y] = pt(R, i);
      return <line class="axis" x1={CX} y1={CY} x2={x.toFixed(1)} y2={y.toFixed(1)} />;
    })}
    <polygon class="value" points={polygon} pathLength={PERIM} />
    {dots.map((d) => <circle class="dot" cx={d.x} cy={d.y} r="3.4" />)}
    {labels.map((l) => (
      <text class="label" x={l.x} y={l.y} text-anchor={l.anchor} dominant-baseline="middle">
        {l.label}
      </text>
    ))}
  </svg>
  <p class="radar-note">自己打的分，玄学一栏可能有幸存者偏差。</p>
</section>

<style>
  .radar-wrap {
    margin-top: 72px;
    padding-top: 32px;
    border-top: 1px solid var(--c-border);
    text-align: center;
  }
  .sec-title {
    font-size: var(--fs-xl);
    margin-bottom: 12px;
  }
  .radar {
    width: min(100%, 340px);
    height: auto;
    overflow: visible;
  }
  .ring {
    fill: none;
    stroke: var(--c-border);
    stroke-width: 1;
  }
  .axis {
    stroke: var(--c-border);
    stroke-width: 1;
    stroke-dasharray: 2 4;
  }
  .value {
    fill: color-mix(in oklch, var(--c-accent) 18%, transparent);
    stroke: var(--c-accent);
    stroke-width: 2;
    stroke-linejoin: round;
    /* 入场：描边展开 + 填充浮现 */
    stroke-dasharray: 480;
    stroke-dashoffset: 480;
    fill-opacity: 0;
    animation: radar-draw 1.2s var(--mo-ease) 0.25s forwards;
  }
  .dot {
    fill: var(--c-accent-strong);
    opacity: 0;
    animation: radar-fade 0.5s var(--mo-ease) 1.1s forwards;
  }
  .label {
    fill: var(--c-fg-muted);
    font-size: 13px;
    font-family: var(--ft-display);
    opacity: 0;
    animation: radar-fade 0.5s var(--mo-ease) 0.9s forwards;
  }
  @keyframes radar-draw {
    to {
      stroke-dashoffset: 0;
      fill-opacity: 1;
    }
  }
  @keyframes radar-fade {
    to {
      opacity: 1;
    }
  }
  .radar-note {
    margin-top: 10px;
    color: var(--c-fg-subtle);
    font-size: var(--fs-xs);
  }
  @media (prefers-reduced-motion: reduce) {
    .value,
    .dot,
    .label {
      animation: none;
      stroke-dashoffset: 0;
      fill-opacity: 1;
      opacity: 1;
    }
  }
</style>
