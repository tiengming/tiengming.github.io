---
/** 主题三态循环：auto（跟系统）→ light → dark，图标即时切换，localStorage 持久化 */
import site from "../config/site";
const initial = site.theme.defaultMode;
---

<button
  id="theme-toggle"
  type="button"
  class="icon-btn"
  aria-label="切换主题"
  data-initial={initial}
>
  <svg class="i i-auto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12a9 9 0 1 1-2.64-6.36" />
    <path d="M21 3v6h-6" />
  </svg>
  <svg class="i i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4" />
  </svg>
  <svg class="i i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.8A8.5 8.5 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
  </svg>
</button>

<style>
  .icon-btn {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: none;
    border-radius: var(--rd-card);
    background: transparent;
    color: var(--c-fg-muted);
    cursor: pointer;
    transition: background-color var(--mo-fast) var(--mo-ease), color var(--mo-fast) var(--mo-ease);
  }
  .icon-btn:hover {
    background: var(--c-surface-2);
    color: var(--c-fg);
  }
  .i {
    grid-area: 1 / 1;
    width: 20px;
    height: 20px;
    opacity: 0;
    transition: opacity var(--mo-base) var(--mo-ease), transform var(--mo-base) var(--mo-ease);
  }
  /* 三态由 html[data-mode] 驱动，默认 auto */
  .i-auto { opacity: 1; }
  :global(html[data-mode="light"]) .i-auto { opacity: 0; }
  :global(html[data-mode="light"]) .i-sun { opacity: 1; }
  :global(html[data-mode="dark"]) .i-auto { opacity: 0; }
  :global(html[data-mode="dark"]) .i-moon { opacity: 1; }
</style>

<script data-astro-rerun>
  const ORDER = ["auto", "light", "dark"] as const;
  const LABELS: Record<string, string> = { auto: "切换主题（当前跟随系统）", light: "切换主题（当前浅色）", dark: "切换主题（当前深色）" };

  function currentMode(): string {
    return document.documentElement.dataset.mode || "auto";
  }

  function apply(mode: string) {
    const root = document.documentElement;
    root.dataset.mode = mode;
    if (mode === "auto") {
      delete root.dataset.theme;
    } else {
      root.dataset.theme = mode;
    }
    try {
      localStorage.setItem("tm-theme", mode);
    } catch {}
    document.getElementById("theme-toggle")?.setAttribute("aria-label", LABELS[mode]);
  }

  // 初始化：把持久化值（或缺省）反映到 data-mode 供图标状态用
  const saved = (() => {
    try {
      return localStorage.getItem("tm-theme");
    } catch {
      return null;
    }
  })();
  document.documentElement.dataset.mode = saved || document.getElementById("theme-toggle")?.dataset.initial || "auto";
  document.getElementById("theme-toggle")?.setAttribute("aria-label", LABELS[currentMode()]);

  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const next = ORDER[(ORDER.indexOf(currentMode() as (typeof ORDER)[number]) + 1) % ORDER.length];
    apply(next);
  });
</script>
