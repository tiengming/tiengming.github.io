---
/** 目录：桌面右轨 sticky + 移动端 <details> 抽屉（无 JS 可用），scrollspy 高亮 */
interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  headings: Heading[];
}
const { headings } = Astro.props;
const visible = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  visible.length > 1 && (
    <>
      <nav class="toc toc-rail" aria-label="目录">
        <p class="toc-title">目录</p>
        <ul>
          {visible.map((h) => (
            <li class:list={["toc-item", { sub: h.depth === 3 }]}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ul>
      </nav>

      <details class="toc toc-mobile">
        <summary>目录</summary>
        <ul>
          {visible.map((h) => (
            <li class:list={["toc-item", { sub: h.depth === 3 }]}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ul>
      </details>
    </>
  )
}

<style>
  .toc-title {
    font-family: var(--ft-display);
    font-size: var(--fs-sm);
    color: var(--c-fg-muted);
    margin-bottom: 8px;
  }
  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .toc-item a {
    display: block;
    padding: 5px 0 5px 12px;
    border-left: 2px solid transparent;
    color: var(--c-fg-subtle);
    text-decoration: none;
    font-size: var(--fs-xs);
    line-height: 1.6;
    transition: color var(--mo-fast) var(--mo-ease), border-color var(--mo-fast) var(--mo-ease);
  }
  .toc-item.sub a {
    padding-left: 24px;
  }
  .toc-item a:hover {
    color: var(--c-fg);
  }
  .toc-item a.active {
    color: var(--c-accent-strong);
    border-left-color: var(--c-accent);
  }

  /* 桌面右轨 */
  .toc-rail {
    position: sticky;
    top: 96px;
    align-self: start;
    max-height: calc(100dvh - 140px);
    overflow-y: auto;
    scrollbar-width: thin;
  }
  .toc-rail {
    display: none;
  }
  @media (min-width: 1100px) {
    .toc-rail {
      display: block;
    }
    .toc-mobile {
      display: none;
    }
  }

  /* 移动端抽屉 */
  .toc-mobile {
    margin: 20px 0 8px;
    border: 1px solid var(--c-border);
    border-radius: var(--rd-card);
    background: color-mix(in oklch, var(--c-surface) 70%, transparent);
    box-shadow: var(--sh-contact);
  }
  .toc-mobile summary {
    cursor: pointer;
    padding: 10px 16px;
    font-size: var(--fs-sm);
    color: var(--c-fg-muted);
    user-select: none;
  }
  .toc-mobile[open] summary {
    border-bottom: 1px solid var(--c-border);
  }
  .toc-mobile ul {
    padding: 8px 16px 12px;
  }
</style>

<script>
  // scrollspy：视口内最末标题即当前项
  const links = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>(".toc-rail .toc-item a").forEach((a) => {
    const id = decodeURIComponent(a.hash.slice(1));
    links.set(id, a);
  });
  if (links.size > 0) {
    const active = new IntersectionObserver(
      (entries) => {
        for (const en of entries) {
          if (!en.isIntersecting) continue;
          links.forEach((a) => a.classList.remove("active"));
          links.get(en.target.id)?.classList.add("active");
        }
      },
      { rootMargin: "-15% 0px -70% 0px" },
    );
    links.forEach((_, id) => {
      const h = document.getElementById(id);
      if (h) active.observe(h);
    });
  }
</script>
