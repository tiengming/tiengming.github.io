---
/** ⌘K 命令面板：多层级浮层（DESIGN.md 签名场景之一）。Pagefind 仅在首次打开时加载。 */
import site from "../config/site";
const enabled = site.features.search;
const nav = [{ label: "首页", href: "/" }, ...site.nav.filter((n) => !n.href.startsWith("/"))];
---

{
  enabled && (
    <>
      <div class="palette-backdrop" hidden />
      <div class="palette" role="dialog" aria-modal="true" aria-label="搜索与快速导航" hidden>
        <div class="palette-input-row">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7" />
            <path d="m20 20-3.8-3.8" />
          </svg>
          <input class="palette-input" type="search" placeholder="搜索文章、标签……" autocomplete="off" spellcheck="false" />
          <kbd class="palette-kbd">Esc</kbd>
        </div>
        <div class="palette-results" role="listbox" aria-label="结果" />
      </div>
    </>
  )
}

<style>
  @keyframes palette-in {
    from {
      opacity: 0;
      transform: translateY(-10px) scale(0.98);
    }
  }
  @keyframes backdrop-in {
    from {
      opacity: 0;
    }
  }

  .palette-backdrop {
    position: fixed;
    inset: 0;
    z-index: 80;
    background: color-mix(in oklch, var(--c-bg) 62%, transparent);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    animation: backdrop-in 160ms var(--mo-ease) both;
    cursor: pointer;
  }
  .palette {
    position: fixed;
    z-index: 81;
    top: 12vh;
    left: 50%;
    width: min(92vw, 34rem);
    transform: translateX(-50%);
    border-radius: var(--rd-card);
    background: color-mix(in oklch, var(--c-surface) 92%, transparent);
    -webkit-backdrop-filter: blur(18px) saturate(1.3);
    backdrop-filter: blur(18px) saturate(1.3);
    box-shadow: var(--sh-card-hover);
    overflow: hidden;
    animation: palette-in 200ms var(--mo-ease) both;
    transform-origin: top center;
  }
  .palette-input-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--c-border);
  }
  .palette-input-row svg {
    width: 18px;
    height: 18px;
    color: var(--c-fg-subtle);
    flex: none;
  }
  .palette-input {
    flex: 1;
    border: none;
    outline: none;
    background: none;
    color: var(--c-fg);
    font-size: var(--fs-base);
    font-family: var(--ft-body);
    min-width: 0;
  }
  .palette-input::placeholder {
    color: var(--c-fg-subtle);
  }
  .palette-kbd {
    padding: 2px 7px;
    border-radius: 6px;
    border: 1px solid var(--c-border);
    border-bottom-width: 2px;
    background: var(--c-surface-2);
    color: var(--c-fg-subtle);
    font-family: var(--ft-mono);
    font-size: 0.72rem;
  }
  .palette-results {
    max-height: min(50dvh, 26rem);
    overflow-y: auto;
    padding: 8px;
    scrollbar-width: thin;
  }

  /* 结果条目 */
  :global(.palette-group) {
    padding: 8px 10px 4px;
    color: var(--c-fg-subtle);
    font-size: var(--fs-xs);
  }
  :global(.palette-item) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 9px 10px;
    border-radius: 8px;
    text-decoration: none;
    color: var(--c-fg);
    cursor: pointer;
  }
  :global(.palette-item .pi-title) {
    font-size: var(--fs-sm);
    line-height: 1.5;
  }
  :global(.palette-item .pi-sub) {
    color: var(--c-fg-subtle);
    font-size: var(--fs-xs);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  :global(.palette-item .pi-sub mark),
  :global(.palette-item .pi-title mark) {
    background: none;
    color: var(--c-accent-strong);
    font-weight: 700;
  }
  :global(.palette-item.selected) {
    background: var(--c-accent-soft);
  }
  :global(.palette-empty) {
    padding: 26px 10px;
    text-align: center;
    color: var(--c-fg-subtle);
    font-size: var(--fs-sm);
  }

  /* 移动端：底部抽屉形态 */
  @media (max-width: 640px) {
    .palette {
      top: auto;
      bottom: 0;
      left: 0;
      width: 100%;
      border-radius: var(--rd-card) var(--rd-card) 0 0;
      transform: none;
      animation-name: palette-in-mobile;
    }
    @keyframes palette-in-mobile {
      from {
        opacity: 0;
        transform: translateY(24px);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .palette,
    .palette-backdrop {
      animation: none;
    }
  }
</style>

<script data-astro-rerun>
  type PfResult = { result: { results: { url: string; meta: { title?: string }; excerpt?: string }[] } };

  const backdrop = document.querySelector<HTMLElement>(".palette-backdrop");
  const panel = document.querySelector<HTMLElement>(".palette");
  const input = document.querySelector<HTMLInputElement>(".palette-input");
  const results = document.querySelector<HTMLElement>(".palette-results");
  if (backdrop && panel && input && results) {
    let pagefind: { search: (q: string) => Promise<PfResult["result"]> } | null = null;
    let selected = -1;
    let lastFocused: HTMLElement | null = null;

    const NAV_ITEMS: { label: string; href: string; sub: string }[] = [
      { label: "首页", href: "/", sub: "回到最新文章" },
      { label: "标签", href: "/tags/", sub: "按标签浏览全部文章" },
      { label: "关于", href: "/about/", sub: "关于本站与作者" },
    ];

    async function open() {
      lastFocused = document.activeElement as HTMLElement;
      backdrop!.hidden = false;
      panel!.hidden = false;
      document.body.style.overflow = "hidden";
      input!.value = "";
      await renderDefault();
      input!.focus();
    }

    function close() {
      backdrop!.hidden = true;
      panel!.hidden = true;
      document.body.style.overflow = "";
      lastFocused?.focus?.();
    }

    const isOpen = () => !panel!.hidden;

    async function ensurePagefind() {
      if (pagefind) return pagefind;
      try {
        pagefind = (await import(/* @vite-ignore */ "/pagefind/pagefind.js")) as never;
        return pagefind;
      } catch {
        return null;
      }
    }

    function itemEl(title: string, sub: string, href: string): HTMLAnchorElement {
      const a = document.createElement("a");
      a.className = "palette-item";
      a.setAttribute("role", "option");
      a.href = href;
      const t = document.createElement("span");
      t.className = "pi-title";
      t.textContent = title;
      const s = document.createElement("span");
      s.className = "pi-sub";
      s.textContent = sub;
      a.append(t, s);
      a.addEventListener("click", () => close());
      return a;
    }

    async function renderDefault() {
      results!.textContent = "";
      const pf = await ensurePagefind();
      let recent: { title: string; url: string }[] = [];
      if (pf) {
        const res = await pf.search("");
        recent = res.results.slice(0, 5).map((r) => ({ title: r.meta.title ?? r.url, url: r.url }));
      }
      const g1 = document.createElement("p");
      g1.className = "palette-group";
      g1.textContent = "快速导航";
      results!.append(g1);
      NAV_ITEMS.forEach((n) => results!.append(itemEl(n.label, n.sub, n.href)));
      if (recent.length > 0) {
        const g2 = document.createElement("p");
        g2.className = "palette-group";
        g2.textContent = "最近文章";
        results!.append(g2);
        recent.forEach((r) => results!.append(itemEl(r.title, "", r.url)));
      }
    }

    async function search(q: string) {
      const pf = await ensurePagefind();
      results!.textContent = "";
      if (!pf) {
        const e = document.createElement("p");
        e.className = "palette-empty";
        e.textContent = "搜索索引加载失败，刷新页面重试";
        results!.append(e);
        return;
      }
      const res = await pf.search(q);
      selected = -1;
      if (res.results.length === 0) {
        const e = document.createElement("p");
        e.className = "palette-empty";
        e.textContent = `没有与「${q}」相关的文章`;
        results!.append(e);
        return;
      }
      const g = document.createElement("p");
      g.className = "palette-group";
      g.textContent = `文章 · ${res.results.length} 条`;
      results!.append(g);
      for (const r of res.results.slice(0, 12)) {
        const a = document.createElement("a");
        a.className = "palette-item";
        a.setAttribute("role", "option");
        a.href = r.url;
        const t = document.createElement("span");
        t.className = "pi-title";
        t.textContent = r.meta.title ?? r.url;
        const s = document.createElement("span");
        s.className = "pi-sub";
        s.innerHTML = r.excerpt ?? "";
        a.append(t, s);
        a.addEventListener("click", () => close());
        results!.append(a);
      }
    }

    function move(dir: 1 | -1) {
      const items = [...results!.querySelectorAll<HTMLElement>(".palette-item")];
      if (items.length === 0) return;
      selected = (selected + dir + items.length) % items.length;
      items.forEach((el, i) => el.classList.toggle("selected", i === selected));
      items[selected].scrollIntoView({ block: "nearest" });
    }

    let debounce = 0;
    input.addEventListener("input", () => {
      const q = input.value.trim();
      clearTimeout(debounce);
      if (!q) {
        renderDefault();
        return;
      }
      debounce = window.setTimeout(() => search(q), 120);
    });

    input.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown") {
        e.preventDefault();
        move(1);
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        move(-1);
      } else if (e.key === "Enter") {
        const item = results!.querySelectorAll<HTMLElement>(".palette-item")[Math.max(selected, 0)];
        if (item instanceof HTMLAnchorElement) {
          close();
          item.click();
        }
      }
    });

    backdrop.addEventListener("click", close);
    document.addEventListener("keydown", (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
        e.preventDefault();
        isOpen() ? close() : open();
      } else if (e.key === "Escape" && isOpen()) {
        close();
      }
    });
    document.getElementById("palette-trigger")?.addEventListener("click", () => open());
  }
</script>
