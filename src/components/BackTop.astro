---
// 返回顶部：滚动超过一屏后浮现（弱动效直跳），右下角浮钮
---

<button id="back-top" type="button" class="back-top" aria-label="返回顶部" hidden>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 19V5M5 12l7-7 7 7" />
  </svg>
</button>

<style>
  .back-top {
    position: fixed;
    right: 18px;
    bottom: 18px;
    z-index: 60;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: color-mix(in oklch, var(--c-surface) 88%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    color: var(--c-fg-muted);
    box-shadow: var(--sh-card);
    cursor: pointer;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity var(--mo-base) var(--mo-ease), transform var(--mo-base) var(--mo-ease),
      color var(--mo-fast) var(--mo-ease), box-shadow var(--mo-base) var(--mo-ease);
  }
  .back-top.show {
    opacity: 1;
    transform: translateY(0);
  }
  .back-top:hover {
    color: var(--c-accent-strong);
    box-shadow: var(--sh-card-hover);
  }
  .back-top svg {
    width: 20px;
    height: 20px;
  }
  @media (prefers-reduced-motion: reduce) {
    .back-top {
      transition: none;
      transform: none;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const btn = document.getElementById("back-top");
    if (!btn) return;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let ticking = false;
    const update = () => {
      const show = window.scrollY > window.innerHeight * 0.6;
      btn.classList.toggle("show", show);
      btn.hidden = !show; // hidden 属性必须同步移除，否则永远 display:none
      ticking = false;
    };
    if (!btn.dataset.bound) {
      btn.dataset.bound = "1";
      window.addEventListener("scroll", () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      }, { passive: true });
    }
    update();
    if (!btn.dataset.clickBound) {
      btn.dataset.clickBound = "1";
      btn.addEventListener("click", () => {
        window.scrollTo({ top: 0, behavior: reduced ? "instant" : "smooth" });
      });
    }
  });
</script>
