---
/** 折腾热力 · GitHub 贡献图式 —— 周列×7 天行，真实发文数据，列波浪入场 */
import type { Post } from "../utils/posts";

interface Props {
  posts: Post[];
}
const { posts } = Astro.props;

// 按天计数
const byDay = new Map<string, number>();
for (const p of posts) {
  const k = p.data.pubDate.toISOString().slice(0, 10);
  byDay.set(k, (byDay.get(k) ?? 0) + 1);
}
const days = [...byDay.values()];
const max = Math.max(...days, 1);
const level = (n: number) => (n === 0 ? 0 : Math.max(1, Math.ceil((n / max) * 4)));

// 网格：从首篇所在周的周日 到 本周末
const today = new Date();
const first = posts.reduce(
  (min, p) => (p.data.pubDate < min ? p.data.pubDate : min),
  posts[0]?.data.pubDate ?? today,
);
const start = new Date(Date.UTC(first.getUTCFullYear(), first.getUTCMonth(), first.getUTCDate()));
start.setUTCDate(start.getUTCDate() - start.getUTCDay()); // 回到周日
const end = new Date(Date.UTC(today.getUTCFullYear(), today.getUTCMonth(), today.getUTCDate()));
end.setUTCDate(end.getUTCDate() + (6 - end.getUTCDay())); // 到本周六

const weeks: { key: string; count: number; level: number }[][] = [];
const monthMarks: { col: number; label: string }[] = [];
let cursor = new Date(start);
let lastMonth = -1;
for (let w = 0; cursor <= end; w++) {
  const col: { key: string; count: number; level: number }[] = [];
  for (let d = 0; d < 7; d++) {
    const k = cursor.toISOString().slice(0, 10);
    const count = byDay.get(k) ?? 0;
    col.push({ key: k, count, level: level(count) });
    cursor = new Date(cursor);
    cursor.setUTCDate(cursor.getUTCDate() + 1);
  }
  weeks.push(col);
  const month = col[3].key ? Number(col[3].key.slice(5, 7)) : lastMonth; // 以周四判定月份归属
  if (month !== lastMonth) {
    monthMarks.push({ col: w, label: `${month}月` });
    lastMonth = month;
  }
}
const totalWeeks = weeks.length;
const lit = days.length;
const WEEKDAY_LABELS = new Map([[1, "一"], [3, "三"], [5, "五"]]);
---

<section class="heatmap-wrap" aria-label="折腾热力图">
  <h2 class="sec-title">折腾热力</h2>
  <p class="hm-sub nums">首篇至今 {lit} 个有产出的日子</p>

  <div class="hm-scroll">
    <div class="hm-grid" style={`--cols:${totalWeeks}`} data-reveal>
      {
        monthMarks.map((m) => (
          <span class="hm-month nums" style={`grid-column:${m.col + 2};grid-row:1`}>
            {m.label}
          </span>
        ))
      }
      {
        [...WEEKDAY_LABELS.entries()].map(([d, label]) => (
          <span class="hm-weekday" style={`grid-column:1;grid-row:${d + 2}`}>
            {label}
          </span>
        ))
      }
      {
        weeks.map((col, w) =>
          col.map((cell, d) => (
            <span
              class:list={["hm-cell", `lv${cell.level}`, cell.count > 0 && "has"]}
              style={`grid-column:${w + 2};grid-row:${d + 2};--w:${w};--d:${d}`}
              title={cell.count > 0 ? `${cell.key} · ${cell.count} 篇` : `${cell.key} · 沉寂`}
            />
          )),
        )
      }
    </div>
  </div>

  <div class="hm-legend" aria-hidden="true">
    <span class="hm-legend-label">少</span>
    {[0, 1, 2, 3, 4].map((l) => <span class:list={["hm-cell", "lv" + l, "sm"]} />)}
    <span class="hm-legend-label">多</span>
  </div>
</section>

<style>
  .heatmap-wrap {
    margin-top: 64px;
    padding-top: 32px;
    border-top: 1px solid var(--c-border);
  }
  .sec-title {
    font-size: var(--fs-xl);
    margin-bottom: 4px;
  }
  .hm-sub {
    color: var(--c-fg-subtle);
    font-size: var(--fs-sm);
    margin-bottom: 18px;
  }
  .hm-scroll {
    overflow-x: auto;
    scrollbar-width: thin;
    padding-bottom: 4px;
  }
  .hm-grid {
    display: grid;
    grid-template-rows: 1.4em repeat(7, 12px);
    grid-auto-columns: 12px;
    grid-auto-flow: column dense;
    gap: 3px;
    width: max-content;
    min-width: 100%;
  }
  .hm-month {
    align-self: end;
    color: var(--c-fg-subtle);
    font-size: var(--fs-xs);
    white-space: nowrap;
  }
  .hm-weekday {
    align-self: center;
    color: var(--c-fg-subtle);
    font-size: var(--fs-xs);
  }

  .hm-cell {
    width: 12px;
    height: 12px;
    border-radius: 2.5px;
    background: color-mix(in oklch, var(--c-surface-2) 82%, var(--c-fg-subtle) 6%);
    /* 波浪入场：列 × 天 交错；容器 reveal-in 后才播放 */
    animation: hm-pop 0.35s var(--mo-ease) both;
    animation-play-state: paused;
    animation-delay: calc(var(--w) * 14ms + var(--d) * 8ms);
  }
  :global(.reveal-in) .hm-cell {
    animation-play-state: running;
  }
  @keyframes hm-pop {
    from {
      opacity: 0;
      transform: scale(0.35);
    }
  }
  .hm-cell.lv1 { background: color-mix(in oklch, var(--c-accent) 26%, var(--c-surface-2)); }
  .hm-cell.lv2 { background: color-mix(in oklch, var(--c-accent) 48%, var(--c-surface-2)); }
  .hm-cell.lv3 { background: color-mix(in oklch, var(--c-accent) 72%, var(--c-surface-2)); }
  .hm-cell.lv4 { background: var(--c-accent); }
  .hm-cell.has:hover {
    transform: scale(1.3);
    box-shadow: 0 0 0 1.5px var(--c-accent);
  }
  .hm-cell.sm {
    width: 12px;
    height: 12px;
    animation: none;
  }

  .hm-legend {
    display: flex;
    align-items: center;
    gap: 4px;
    justify-content: flex-end;
    margin-top: 10px;
  }
  .hm-legend-label {
    color: var(--c-fg-subtle);
    font-size: var(--fs-xs);
    margin: 0 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .hm-cell {
      animation: none;
    }
  }
</style>
