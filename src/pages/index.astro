---
import BaseLayout from "../layouts/BaseLayout.astro";
import site from "../config/site";
---

<BaseLayout>
  <section class="hero landing">
    <h1>{site.site.title}</h1>
    <p>{site.site.subtitle}</p>
  </section>
</BaseLayout>

<style>
  .landing {
    max-width: var(--w-prose);
    margin: 0 auto;
    padding: 96px 20px;
  }
</style>
