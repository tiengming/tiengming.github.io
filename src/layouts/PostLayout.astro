---
import BaseLayout from "./BaseLayout.astro";
import PostMeta from "../components/PostMeta.astro";
import Toc from "../components/Toc.astro";
import Comments from "../components/Comments.astro";
import site from "../config/site";
import { excerpt } from "../utils/posts";

interface Props {
  title: string;
  pubDate: Date;
  updatedDate?: Date;
  labels: string[];
  issueNumber: number;
  comments: number;
  source: string;
  headings: { depth: number; slug: string; text: string }[];
}

const props = Astro.props;
const desc = excerpt(String(Astro.slots.render("default") ?? ""), 110) || site.site.description;
const id = props.issueNumber;
const archived = props.labels.includes(site.issues.archivedLabel);
---

<BaseLayout title={props.title} description={desc} ogType="article">
  <div class="read-progress" aria-hidden="true"><i></i></div>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: props.title,
      datePublished: props.pubDate.toISOString(),
      dateModified: (props.updatedDate ?? props.pubDate).toISOString(),
      keywords: props.labels.join(","),
      url: `${site.site.url}/p/${id}/`,
      mainEntityOfPage: `${site.site.url}/p/${id}/`,
      author: { "@type": "Person", name: site.author.name, url: site.site.url },
    })}
  />
  <article class="post container" data-pagefind-body>
    <header class="post-head" transition:name={`post-card-${id}`}>
      <h1 class="post-title" transition:name={`post-title-${id}`}>{props.title}</h1>
      <PostMeta
        pubDate={props.pubDate}
        updatedDate={props.updatedDate}
        labels={props.labels}
        comments={props.comments}
        source={props.source}
      />
    </header>

    {
      archived && (
        <aside class="archived-banner" role="note">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 8v4.5M12 16h.01" />
          </svg>
          本文内容已过时，仅供存档参考；最新进展见首页。
        </aside>
      )
    }

    <div class="post-body">
      <Toc headings={props.headings} />
      <div class="prose">
        <slot />
      </div>
    </div>

    <footer class="post-foot">
      <p class="post-bottom">{site.footer.text} · <a href={props.source} rel="noopener" target="_blank">在 GitHub 上编辑</a></p>
    </footer>

    <Comments issueNumber={id} />
  </article>
</BaseLayout>

<script>
  import { attachLightbox } from "../scripts/lightbox";
  document.addEventListener("astro:page-load", () => {
    attachLightbox(document);

    // 阅读进度：按文章元素自身范围计算（页脚/评论不计入）
    const w = window as unknown as { __tmReadBound?: boolean };
    const update = () => {
      const bar = document.querySelector<HTMLElement>(".read-progress i");
      const article = document.querySelector<HTMLElement>("article.post");
      if (!bar || !article) return;
      const rect = article.getBoundingClientRect();
      const total = rect.height - innerHeight;
      const passed = Math.min(Math.max(-rect.top, 0), Math.max(total, 1));
      bar.style.transform = `scaleX(${total > 0 ? (passed / total).toFixed(4) : "0"})`;
    };
    if (!w.__tmReadBound) {
      w.__tmReadBound = true;
      let ticking = false;
      window.addEventListener(
        "scroll",
        () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            update();
            ticking = false;
          });
        },
        { passive: true },
      );
    }
    update();
  });
</script>

<style>
  /* 横向阅读进度条：文章滚动进度（scaleX 变换，零重排） */
  .read-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    z-index: 55;
    pointer-events: none;
  }
  .read-progress i {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--c-accent), var(--c-accent-strong));
    transform: scaleX(0);
    transform-origin: left center;
  }

  .container {
    max-width: var(--w-wide);
    margin: 0 auto;
    padding: 56px 20px 0;
  }

  .post-head {
    max-width: var(--w-prose);
    margin: 0 auto 28px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--c-border);
  }
  .post-title {
    font-size: clamp(var(--fs-xl), 4.6vw, var(--fs-2xl));
    line-height: 1.35;
  }

  .archived-banner {
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: var(--w-prose);
    margin: 0 auto 20px;
    padding: 10px 16px;
    border-left: 2px solid var(--c-warning);
    border-radius: 0 var(--rd-card) var(--rd-card) 0;
    background: color-mix(in oklch, var(--c-warning) 10%, transparent);
    color: var(--c-fg-muted);
    font-size: var(--fs-sm);
  }
  .archived-banner svg {
    width: 17px;
    height: 17px;
    flex: none;
    color: var(--c-warning);
  }

  /* 桌面三区：正文 44rem 主列 + 右轨目录；目录在 <1100px 时移动端抽屉化（见 Toc）。
     注意：order 各自写在所属组件里（Astro 作用域下跨组件子选择器不命中） */
  .post-body {
    display: block;
    max-width: var(--w-prose);
    margin: 0 auto;
  }
  .prose {
    min-width: 0;
  }
  @media (min-width: 1100px) {
    .post-body {
      display: grid;
      grid-template-columns: minmax(0, 44rem) 200px;
      gap: 56px;
      max-width: none;
      justify-content: center;
    }
    .prose {
      order: 1;
      grid-column: 1;
    }
  }

  .post-foot {
    max-width: var(--w-prose);
    margin: 56px auto 0;
    color: var(--c-fg-subtle);
    font-size: var(--fs-sm);
    text-align: center;
  }
  .post-foot a {
    color: var(--c-accent-strong);
  }

  /* 灯箱浮层（多层级最上） */
  :global(.lightbox) {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: grid;
    place-items: center;
    padding: 32px;
    background: color-mix(in oklch, var(--c-bg) 82%, transparent);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    cursor: zoom-out;
  }
  :global(.lightbox img) {
    max-width: min(92vw, 1200px);
    max-height: 88dvh;
    width: auto;
    height: auto;
    border-radius: var(--rd-card);
    box-shadow: var(--sh-card-hover);
    cursor: auto;
  }
</style>
